APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_KEY=pk_test_...
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ─── Efí Bank (PIX Direto) ────────────────────────────────────────────────────
# Docs: https://app.sejaefi.com.br → API → Credenciais
EFI_URL=https://pix.api.efipay.com.br
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_PATH=        # Caminho absoluto do certificado .pem no servidor (ex: /app/certs/efi.pem)
EFI_PIX_KEY=          # Sua chave PIX (CPF, CNPJ, e-mail ou chave aleatória)
EFI_SANDBOX=true      # Mude para false em produção

# ─── OxaPay (Criptomoeda) ─────────────────────────────────────────────────────
# Docs: https://oxapay.com → API → Merchant Keys
OXAPAY_MERCHANT_KEY=
OXAPAY_WEBHOOK_SECRET=  # Opcional, para validar assinatura HMAC dos webhooks

# ─── Wise (Transferência Internacional) ───────────────────────────────────────
# Docs: https://wise.com/settings/tokens (precisa de conta Business)
WISE_API_KEY=
WISE_PROFILE_ID=     # GET https://api.transferwise.com/v1/profiles (após gerar API Key)
WISE_ACCOUNT_EMAIL=  # E-mail da sua conta Wise que vai receber os pagamentos
WISE_WEBHOOK_SECRET= # Opcional, para validar assinatura SHA-256 dos webhooks
WISE_SANDBOX=true    # Mude para false em produção

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT="${APP_URL}/api/v1/auth/google/callback"

# ─── Frontend / App ───────────────────────────────────────────────────────────
FRONTEND_URL=https://mtdstore.xyz
NEXT_PUBLIC_SITE_URL=https://mtdstore.xyz

