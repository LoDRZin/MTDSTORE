{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "backend",
      "framework": null,
      "functions": {
        "api/index.php": {
          "runtime": "vercel-php@0.7.2"
        }
      },
      "routes": [
        {
          "src": "/(.*)",
          "dest": "/api/index.php"
        }
      ]
    }
  }
}
